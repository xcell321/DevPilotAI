{
  "name": "devpilot-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w server && npm run build -w apps/web",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w apps/web",
    "lint": "eslint .",
    "test": "npm run test -w server",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "test:e2e:production": "node tests/e2e/production.mjs",
    "test:claude": "node scripts/claude-check.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e && npm run test:e2e:production",
    "electron:dev": "cross-env DEVPILOT_ELECTRON_DEV=1 electron electron/main.cjs",
    "electron:build": "npm run build && electron-builder --win",
    "dist": "npm run electron:build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "playwright-core": "1.64.1",
    "typescript-eslint": "8.72.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-rebuild": "^3.2.9",
    "cross-env": "^7.0.3"
  },
  "main": "electron/main.cjs"
}