# Server (port 0 asks the OS for a free local port)
DEVPILOT_HOST=127.0.0.1
DEVPILOT_PORT=0
DEVPILOT_DB_PATH=./data/devpilot.db
# Optional: isolate the generated runtime/token file (defaults to ./.devpilot).
# Relative paths are resolved from the repository root. The dev runner and Vite
# use the same directory as the server.
# DEVPILOT_RUNTIME_DIR=./.devpilot
# Maximum number of live terminal processes across this backend.
DEVPILOT_MAX_TERMINALS=8
# Maximum number of terminals in one session (UI reads this from the backend).
DEVPILOT_MAX_TERMINALS_PER_SESSION=4
# Maximum number of agent tasks that may run concurrently on this backend. Projects
# can request fewer, never more. Kept conservative by default on purpose.
DEVPILOT_MAX_CONCURRENT_AGENTS=2

# Optional CLI executable overrides. When unset, DevPilot checks PATH and known
# npm/global install locations. An invalid explicit path is reported, not replaced.
# DEVPILOT_CLAUDE_PATH=C:\path with spaces\claude.exe
# DEVPILOT_OPENCODE_PATH=C:\path with spaces\opencode.exe
# DEVPILOT_FREEBUFF_PATH=C:\path with spaces\freebuff.exe

# Web dev server. The root `npm run dev` command sets these automatically.
DEVPILOT_SERVER_ORIGIN=http://127.0.0.1:4318
DEVPILOT_WEB_PORT=5173
